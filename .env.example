# Borealis Outreach System — Environment Example
# Copy to .env only for local testing. In GitHub Actions, use repository secrets/variables instead.

# Safe default: dry_run validates prospects and updates reports without sending email.
SEND_MODE=dry_run

# Hard capped by the application at 100 even if this is set higher.
DAILY_LIMIT=10

# Path to verified prospect CSV.
PROSPECTS_FILE=data/prospects.csv

# SMTP settings for live mode only. Prefer an app password or SMTP-specific password.
SENDER_EMAIL=your-sender@example.com
SENDER_PASSWORD=replace-with-app-password

# Live mode will not send unless this is exactly true.
# Set only after verifying lawful basis, prospect source, and unsubscribe handling.
CONFIRM_COMPLIANCE=false
